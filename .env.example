# IndexCore runtime configuration.
# Flags with the same meaning override these environment values.

# Required PostgreSQL DSN.
INDEXCORE_DATABASE_URL=postgres://indexcore:indexcore@127.0.0.1:5432/indexcore?sslmode=disable

# Safe default: keep the unauthenticated Alpha HTTP API on loopback/private networking.
INDEXCORE_HTTP_ADDR=127.0.0.1:8080

# Collector runtime.
INDEXCORE_RCLONE_PATH=rclone
# INDEXCORE_RCLONE_CONFIG=/path/to/rclone.conf

# Runtime limits.
INDEXCORE_MAX_CONCURRENT_ROOTS=4
INDEXCORE_SCAN_TIMEOUT=30m
INDEXCORE_SHUTDOWN_TIMEOUT=15s

# Logging.
INDEXCORE_LOG_LEVEL=info
INDEXCORE_LOG_FORMAT=text

# Accepted trusted Hint transport. Disabled when INDEXCORE_HINT_ADDR is
# empty. The listener is loopback-only and bearer-token authenticated. The token
# is env-only (there is no --hint-token flag) and must be at least 32 bytes.
# INDEXCORE_HINT_ADDR=127.0.0.1:8090
# INDEXCORE_HINT_TOKEN=replace-with-at-least-32-random-bytes

# Accepted P10/P11 hybrid incremental runtime. Disabled by default. When enabled
# it runs one serialized P6 cycle at a time inside `serve` under the same writer
# lock. The wake interval is a scheduler check interval (1s..60s), NOT provider
# polling cadence; persisted ScopeWatchState.next_due_at stays authoritative.
# INDEXCORE_INCREMENTAL_RUNTIME_ENABLED=false
# INDEXCORE_INCREMENTAL_WAKE_INTERVAL=5s

# AList/OpenList credentials are referenced by environment-variable NAME in the
# per-root adapter config. Example adapter JSON may use "token_env":"ALIST_TOKEN".
# ALIST_TOKEN=
# ALIST_USERNAME=
# ALIST_PASSWORD=

# Test-only PostgreSQL DSN used by the DB-backed Go tests when set.
# INDEXCORE_TEST_DATABASE_URL=postgres://indexcore:indexcore@127.0.0.1:55432/indexcore?sslmode=disable
